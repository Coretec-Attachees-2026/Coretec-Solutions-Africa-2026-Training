{
  "info": {
    "_postman_id": "members-api-collection",
    "name": "Members API - Coretec SACCO",
    "description": "OData API for reading SACCO member data\nAPI Publisher: coretec\nAPI Group: members\nVersion: v1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Members Endpoints",
      "item": [
        {
          "name": "Get All Members (First 10)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$top=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$top",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve the first 10 member records"
          },
          "response": []
        },
        {
          "name": "Get Active Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$filter=status eq 'Active'&$top=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$filter",
                  "value": "status eq 'Active'"
                },
                {
                  "key": "$top",
                  "value": "10"
                }
              ]
            },
            "description": "Filter and get only Active members"
          },
          "response": []
        },
        {
          "name": "Get Single Member by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members('MEM-20260303-0001')",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members('MEM-20260303-0001')"
              ]
            },
            "description": "Retrieve a specific member by their Member ID"
          },
          "response": []
        },
        {
          "name": "Get Members with Pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$skip=0&$top=50&$orderby=registrationDate desc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$skip",
                  "value": "0"
                },
                {
                  "key": "$top",
                  "value": "50"
                },
                {
                  "key": "$orderby",
                  "value": "registrationDate desc"
                }
              ]
            },
            "description": "Get members with pagination (skip 0, take 50) sorted by registration date descending"
          },
          "response": []
        },
        {
          "name": "Get Members by Category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$filter=memberCategory eq 'REGULAR'&$top=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$filter",
                  "value": "memberCategory eq 'REGULAR'"
                },
                {
                  "key": "$top",
                  "value": "20"
                }
              ]
            },
            "description": "Filter members by Member Category"
          },
          "response": []
        },
        {
          "name": "Get Recent Members (Last 30 days)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$filter=registrationDate ge 2026-03-01&$orderby=registrationDate desc&$top=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$filter",
                  "value": "registrationDate ge 2026-03-01"
                },
                {
                  "key": "$orderby",
                  "value": "registrationDate desc"
                },
                {
                  "key": "$top",
                  "value": "100"
                }
              ]
            },
            "description": "Get members registered after March 1, 2026"
          },
          "response": []
        },
        {
          "name": "Get Member Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$count=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$count",
                  "value": "true"
                }
              ]
            },
            "description": "Get count of total members in the system"
          },
          "response": []
        },
        {
          "name": "Get Specific Fields Only (Select)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/coretec/members/v1.0/members?$select=memberId,fullName,email&$top=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "coretec",
                "members",
                "v1.0",
                "members"
              ],
              "query": [
                {
                  "key": "$select",
                  "value": "memberId,fullName,email"
                },
                {
                  "key": "$top",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve only specific fields (memberId, fullName, email) for efficiency"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/BC260",
      "type": "string"
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      },
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      }
    ]
  }
}
