<?xml version="1.0" encoding="utf-8"?>
<!--
  LoanSummaryByMember.rdl
  ========================
  This file has been rewritten for compatibility with Business Central (SSRS 2008 R2 schema).
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a1b2c3d4-0001-0001-0001-a1b2c3d4e5f6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- ======================================================= -->
          <!-- REPORT TITLE                                             -->
          <!-- ======================================================= -->
          <Textbox Name="TxtReportTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!ReportTitle.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#333333</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>1cm</Height>
            <Width>19cm</Width>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <!-- COMPANY NAME -->
          <Textbox Name="TxtCompanyName">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!CompanyName.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>10pt</FontSize>
                      <Color>#666666</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>1.1cm</Top>
            <Left>0cm</Left>
            <Height>0.7cm</Height>
            <Width>19cm</Width>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          <!-- ======================================================= -->
          <!-- MAIN TABLE                                               -->
          <!--                                                          -->
          <!-- STRUCTURE:                                               -->
          <!--   TablixRowHierarchy                                     -->
          <!--     ├─ Column header row (static)                       -->
          <!--     └─ MemberGroup (grouped by MemberID)                -->
          <!--          ├─ Member header row (Member ID + Full Name)   -->
          <!--          └─ LoanDetail rows (one per loan)              -->
          <!-- ======================================================= -->
          <Tablix Name="TblLoanSummary">
            <TablixBody>
              <TablixColumns>
                <!-- Col 1: Loan Application No.  -->
                <TablixColumn>
                  <Width>4.5cm</Width>
                </TablixColumn>
                <!-- Col 2: Loan Amount (formatted) -->
                <TablixColumn>
                  <Width>3.5cm</Width>
                </TablixColumn>
                <!-- Col 3: Loan Status             -->
                <TablixColumn>
                  <Width>3.5cm</Width>
                </TablixColumn>
                <!-- Col 4: Application Date        -->
                <TablixColumn>
                  <Width>3cm</Width>
                </TablixColumn>
                <!-- Col 5: Total Repayment          -->
                <TablixColumn>
                  <Width>4cm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- ─────────────────────────────────────────────── -->
                <!-- ROW 1: Column header row (blue background)       -->
                <!-- ─────────────────────────────────────────────── -->
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HdrLoanNo">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Loan Application No.</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#4472C4</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HdrLoanAmount">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Loan Amount</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#4472C4</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HdrStatus">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Status</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#4472C4</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HdrAppDate">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>App. Date</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#4472C4</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HdrTotalRepayment">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Total Repayment</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>White</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#4472C4</BackgroundColor>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- ─────────────────────────────────────────────── -->
                <!-- ROW 2: Member group header (no ColSpan, BC compatible) -->
                <!-- Shows Member ID + Full Name in first cell, others empty -->
                <!-- ─────────────────────────────────────────────── -->
                <TablixRow>
                  <Height>0.7cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValMemberHeader">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!MemberID.Value &amp; "  —  " &amp; Fields!FullName.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#333333</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#D9E1F2</BackgroundColor>
                            <PaddingLeft>6pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell />
                    <TablixCell />
                    <TablixCell />
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <!-- ─────────────────────────────────────────────── -->
                <!-- ROW 3: Loan detail row                           -->
                <!-- ─────────────────────────────────────────────── -->
                <TablixRow>
                  <Height>0.6cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValLoanNo">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!LoanAppNo.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Color>#DDDDDD</Color>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValLoanAmount">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!LoanAmountFormat.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Color>#DDDDDD</Color>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValStatus">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!LoanStatus.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Color>#DDDDDD</Color>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValAppDate">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!ApplicationDate.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Color>#DDDDDD</Color>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ValTotalRepayment">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!TotalRepaymentFormat.Value</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                              <Color>#DDDDDD</Color>
                              <Width>0.5pt</Width>
                            </BottomBorder>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <!-- ─────────────────────────────────────────────────── -->
            <!-- COLUMN HIERARCHY (one entry per column)             -->
            <!-- ─────────────────────────────────────────────────── -->
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <!-- ─────────────────────────────────────────────────── -->
            <!-- ROW HIERARCHY                                        -->
            <!--                                                      -->
            <!--  Static header row (row 1 = column labels)          -->
            <!--  MemberGroup (grouped by MemberID)                  -->
            <!--    ├─ Member header sub-row (row 2)                  -->
            <!--    └─ LoanDetail sub-rows  (row 3, repeats)         -->
            <!-- ─────────────────────────────────────────────────── -->
            <TablixRowHierarchy>
              <TablixMembers>
                <!-- Static column-header row (row 1) -->
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                </TablixMember>
                <!-- Outer group: one block per Member -->
                <TablixMember>
                  <Group Name="MemberGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!MemberID.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <!-- Keep member header with the following loan rows -->
                  <KeepTogether>true</KeepTogether>
                  <TablixMembers>
                    <!-- Member header row (row 2 within the group) -->
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                    </TablixMember>
                    <!-- Loan detail rows (row 3, repeated for each loan) -->
                    <TablixMember>
                      <Group Name="LoanDetail" />
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>DataSet_Result</DataSetName>
            <Top>2.2cm</Top>
            <Left>0cm</Left>
            <Height>2cm</Height>
            <Width>18.5cm</Width>
          </Tablix>
          <!-- PRINT DATE -->
          <Textbox Name="TxtPrintDate">
            <CanGrow>true</CanGrow>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Printed on: " &amp; First(Fields!PrintDate.Value, "DataSet_Result")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontStyle>Italic</FontStyle>
                      <Color>#999999</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Right</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <Top>4.5cm</Top>
            <Left>0cm</Left>
            <Height>0.5cm</Height>
            <Width>18.5cm</Width>
            <Style>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
        </ReportItems>
        <Height>5.5cm</Height>
        <Style />
      </Body>
      <Width>21cm</Width>
      <Page>
        <PageHeader>
          <Height>0cm</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <Style />
        </PageHeader>
        <PageFooter>
          <Height>0.8cm</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="TxtPageNumber">
              <CanGrow>true</CanGrow>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>8pt</FontSize>
                        <Color>#999999</Color>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Center</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0cm</Top>
              <Left>0cm</Left>
              <Height>0.7cm</Height>
              <Width>19cm</Width>
              <Style>
                <PaddingLeft>2pt</PaddingLeft>
                <PaddingRight>2pt</PaddingRight>
                <PaddingTop>2pt</PaddingTop>
                <PaddingBottom>2pt</PaddingBottom>
              </Style>
            </Textbox>
          </ReportItems>
          <Style />
        </PageFooter>
        <PageHeight>29.7cm</PageHeight>
        <PageWidth>21cm</PageWidth>
        <LeftMargin>1.5cm</LeftMargin>
        <RightMargin>1.5cm</RightMargin>
        <TopMargin>1cm</TopMargin>
        <BottomMargin>1cm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
  <!-- ======================================================= -->
  <!-- DATASET DEFINITION                                       -->
  <!-- FIX: was "DataSet1" – now "DataSet_Result" (BC standard) -->
  <!-- ======================================================= -->
  <DataSets xmlns="">
    <DataSet Name="DataSet_Result" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
      <Fields>
        <Field Name="MemberID">
          <DataField>MemberID</DataField>
        </Field>
        <Field Name="FullName">
          <DataField>FullName</DataField>
        </Field>
        <Field Name="MemberStatus">
          <DataField>MemberStatus</DataField>
        </Field>
        <Field Name="CompanyName">
          <DataField>CompanyName</DataField>
        </Field>
        <Field Name="ReportTitle">
          <DataField>ReportTitle</DataField>
        </Field>
        <Field Name="PrintDate">
          <DataField>PrintDate</DataField>
        </Field>
        <Field Name="LoanAppNo">
          <DataField>LoanAppNo</DataField>
        </Field>
        <Field Name="LoanAmount">
          <DataField>LoanAmount</DataField>
        </Field>
        <Field Name="LoanAmountFormat">
          <DataField>LoanAmountFormat</DataField>
        </Field>
        <Field Name="LoanStatus">
          <DataField>LoanStatus</DataField>
        </Field>
        <Field Name="ApplicationDate">
          <DataField>ApplicationDate</DataField>
        </Field>
        <Field Name="InterestRate">
          <DataField>InterestRate</DataField>
        </Field>
        <Field Name="InterestRateFormat">
          <DataField>InterestRateFormat</DataField>
        </Field>
        <Field Name="LoanTerm">
          <DataField>LoanTerm</DataField>
        </Field>
        <Field Name="TotalRepayment">
          <DataField>TotalRepayment</DataField>
        </Field>
        <Field Name="TotalRepaymentFormat">
          <DataField>TotalRepaymentFormat</DataField>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DataSource</DataSourceName>
        <CommandText />
      </Query>
    </DataSet>
  </DataSets>
  <ReportParameters xmlns="">
    <ReportParameter Name="LoanSummaryByMemberLbl">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>LoanSummaryByMemberLbl</Value>
        </Values>
      </DefaultValue>
      <Prompt>LoanSummaryByMemberLbl</Prompt>
    </ReportParameter>
    <ReportParameter Name="MemberLbl">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>MemberLbl</Value>
        </Values>
      </DefaultValue>
      <Prompt>MemberLbl</Prompt>
    </ReportParameter>
    <ReportParameter Name="LoansLbl">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>LoansLbl</Value>
        </Values>
      </DefaultValue>
      <Prompt>LoansLbl</Prompt>
    </ReportParameter>
    <ReportParameter Name="TotalLbl">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>TotalLbl</Value>
        </Values>
      </DefaultValue>
      <Prompt>TotalLbl</Prompt>
    </ReportParameter>
    <ReportParameter Name="PageNoLbl">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>PageNoLbl</Value>
        </Values>
      </DefaultValue>
      <Prompt>PageNoLbl</Prompt>
    </ReportParameter>
    <ReportParameter Name="PrintedOnLbl">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>PrintedOnLbl</Value>
        </Values>
      </DefaultValue>
      <Prompt>PrintedOnLbl</Prompt>
    </ReportParameter>
    <ReportParameter Name="MemberIDCaption">
      <DataType>String</DataType>
